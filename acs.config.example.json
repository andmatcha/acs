{
  "log_dir": "logs",
  "control": {
    "port": "",
    "baud": 115200,
    "controller": "0",
    "format": "packetacv6",
    "display": {
      "default": "hex+ascii",
      "input": {
        "default": "ascii+line"
      },
      "output": {
        "default": "hex"
      }
    },
    "monitor_ports": []
  },
  "send": {
    "baud": 115200,
    "rate": 50,
    "outputs": [
      {
        "id": "main",
        "port": "/dev/ttyUSB0",
        "baud": 115200,
        "rate": 100,
        "format": "packetjfv1",
        "display": "hex+packet"
      },
      {
        "id": "sub",
        "port": "/dev/ttyUSB2",
        "baud": 921600,
        "rate": 10,
        "format": "packetacv6",
        "display": "utf8+line"
      }
    ],
    "monitor_ports": [],
    "display": {
      "input": {
        "default": "hex+line"
      },
      "output": {
        "default": "hex"
      }
    }
  },
  "xbee_test": {
    "ports": [
      {
        "id": "base",
        "port": "/dev/ttyUSB0",
        "baud": 921600
      },
      {
        "id": "remote",
        "port": "/dev/ttyUSB1",
        "baud": 115200
      }
    ],
    "mode": "polling",
    "poll_rate": 100,
    "base_real_percent": 10,
    "remote_real_percent": 20,
    "au_rate": 100,
    "ru_rate": 100,
    "ad_rate": 100,
    "rd_rate": 100
  },
  "xbee_mock": {
    "role": "base",
    "port": {
      "port": "/dev/ttyUSB0",
      "baud": 921600
    },
    "mode": "polling",
    "poll_rate": 100,
    "base_real_percent": 10,
    "remote_real_percent": 20,
    "au_rate": 100,
    "ru_rate": 100,
    "ad_rate": 100,
    "rd_rate": 100
  },
  "monitor": {
    "ports": [],
    "baud": 115200,
    "display": {
      "default": "hex+ascii",
      "input": {
        "default": "hex+ascii+line"
      }
    }
  },
  "route": {
    "baud": 115200,
    "display": {
      "default": "hex+utf8",
      "input": {
        "default": "hex+utf8+packet"
      },
      "output": {
        "default": "hex"
      }
    },
    "inputs": [
      {
        "id": "in_a",
        "port": "/dev/ttyUSB0",
        "baud": 921600,
        "display": "utf8"
      },
      {
        "id": "in_b",
        "port": "/dev/ttyUSB1",
        "baud": 115200,
        "display": "hex+ascii"
      }
    ],
    "outputs": [
      {
        "id": "out_main",
        "port": "/dev/ttyUSB2",
        "baud": 460800,
        "display": "hex"
      },
      {
        "id": "out_sub",
        "port": "/dev/ttyUSB3",
        "baud": 115200,
        "display": "hex+ascii"
      }
    ],
    "pipelines": [
      {
        "id": "merge_passthrough",
        "inputs": ["in_a", "in_b"],
        "filter": {
          "module": "allow_all"
        },
        "transform": {
          "module": "identity"
        },
        "classify": {
          "module": "by_source"
        },
        "route": {
          "module": "broadcast",
          "outputs": ["out_main"]
        }
      },
      {
        "id": "paired_to_both",
        "inputs": ["in_a", "in_b"],
        "filter": {
          "module": "allow_all"
        },
        "transform": {
          "module": "join_latest",
          "separator_hex": "2c"
        },
        "classify": {
          "module": "tag_static",
          "tags": ["paired"]
        },
        "route": {
          "module": "broadcast",
          "outputs": ["out_main", "out_sub"]
        }
      }
    ],
    "templates": {
      "merge_csv": {
        "description": "join latest payloads with comma and broadcast",
        "pipelines": [
          {
            "id": "merge_csv",
            "transform": {
              "module": "join_latest",
              "separator_hex": "2c",
              "require_all": true
            },
            "route": {
              "module": "broadcast"
            }
          }
        ]
      }
    }
  }
}
