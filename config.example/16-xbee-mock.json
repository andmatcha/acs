{
  "xbee_mock": {
    "role": "base",
    "ports": [
      {
        "id": "up",
        "port": "/dev/ttyUSB0",
        "baud": 921600
      },
      {
        "id": "down",
        "port": "/dev/ttyUSB1",
        "baud": 115200
      }
    ],
    "pair": 2,
    "tx_format": "packetacv6@100+roverupgeneral@20",
    "rx_format": "packetjfv1+roverdowngeneral",
    "traffic_pattern": "flood"
  }
}
